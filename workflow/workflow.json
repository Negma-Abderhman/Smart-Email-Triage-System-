        "promptType": "define",
        "text": "=Write a professional email reply.\n\n- Be polite and clear\n- Respond appropriately to the email\n- Keep it concise\n- Sign as Negma\n\nOriginal Email:\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\n\n{{ $json.emailText }}\n",
        "options": {
          "systemMessage": "Draft a professional reply to this email. Match the sender's tone (formal or casual). Be concise and helpful. Sign as \"AI Assistant (Draft - Please Review)\".",
