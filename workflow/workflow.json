  "name": "Smart Email Triage System",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an email classifier.\n\nClassify the email into ONE of:\nURGENT, IMPORTANT, NEWSLETTER, SPAM.\n\nIMPORTANT RULES:\n- category must be EXACTLY one word (no spaces, no new lines)\n- do NOT add any spaces or new lines before or after the value\n- output must be compact JSON in one single line\n\nReturn ONLY JSON like this:\n{\"category\":\"URGENT\",\"reason\":\"short explanation\"}\n\nEmail:\n{{ $json.snippet }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You classify emails into exactly one of: URGENT, IMPORTANT, NEWSLETTER, SPAM. Respond with JSON: {\"category\":\"...\", \"reason\":\"...\"}.\n\nURGENT: Requires immediate action or response (meetings, deadlines, time-sensitive requests)\nIMPORTANT: Needs attention but not urgent (project updates, work discussions)\nNEWSLETTER: Marketing emails, subscriptions, promotional content\nSPAM: Unwanted or suspicious emails",
          "maxIterations": 1
        }
      },
      "id": "ce0a4aaa-ce9d-4020-8bca-bd9c5428c6fa",
      "name": "Classify Email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        528,
        344
      ]
    },
